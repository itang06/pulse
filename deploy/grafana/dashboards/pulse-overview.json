{
  "title": "Pulse Overview",
  "uid": "pulse-overview",
  "schemaVersion": 39,
  "editable": false,
  "time": { "from": "now-15m", "to": "now" },
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Gateway: events received per second",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "rate(pulse_gateway_events_received_total[1m])", "legendFormat": "events/s" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Gateway: active requests",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "pulse_gateway_active_requests", "legendFormat": "requests" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Processor: anomalies per second",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "rate(pulse_processor_anomalies_total[1m])", "legendFormat": "anomalies/s" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Processor: processing latency p99",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(pulse_processor_processing_latency_seconds_bucket[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Sink: events persisted per second",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "rate(pulse_sink_events_persisted_total[1m])", "legendFormat": "events/s" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Sink: estimated consumer lag",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "pulse_sink_consumer_lag_records_estimate", "legendFormat": "records" }
      ]
    }
  ]
}
