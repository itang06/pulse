# Copy to deploy/.env and change the values. deploy/.env is gitignored;
# never commit it.

# TimescaleDB (compose service + local connections)
POSTGRES_USER=pulse
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=pulse

# Grafana admin login (anonymous access is view-only)
GRAFANA_ADMIN_PASSWORD=change-me-dev-only

# For running the sink on the host during dev (matches the values above):
#   export PULSE_DATABASE_URL=postgres://pulse:change-me-dev-only@localhost:5432/pulse
